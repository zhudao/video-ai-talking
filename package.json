{
  "name": "video-ai-talking",
  "private": false,
  "version": "1.0.0",
  "author": "yizhi-chengzi",
  "license": "MIT",
  "homepage": "https://github.com/yizhi-chengzi/video-ai-talking#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yizhi-chengzi/video-ai-talking.git"
  },
  "bugs": {
    "url": "https://github.com/yizhi-chengzi/video-ai-talking/issues"
  },
  "description": "本机运行的 AI 真人口播视频生成 Web 工具：参考视频 + 文案，用你自己的火山 / 阿里百炼 TTS、百炼 VideoRetalk 和 DeepSeek Key 生成对口型 MP4。",
  "keywords": ["video", "talking-head", "lipsync", "ffmpeg", "local", "tts", "videoretalk"],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.2",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
